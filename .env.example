# Agent Games agent secrets — issued ONCE by the dashboard at agent
# registration (32-byte HMAC secret per agent). Set in the host's env
# (Vercel project settings), never commit real values.
STEAL_SECRET=
GATEKEEPER_SECRET=
# Optional: KURIER_API_KEY enables submitting decision proofs to zkVerify
# via Kurier (only used if the platform requires on-chain proof txs).
KURIER_API_KEY=
PORT=3000
